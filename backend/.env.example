PORT=
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CORS_ORIGIN=http://localhost:5173
GUEST_SESSION_TTL=24h
GUEST_COOKIE_SECURE=false
GUEST_COOKIE_SAME_SITE=Lax

AWS_S3_BUCKET=
AWS_S3_TRACKS_KEY="tracks/"
AWS_S3_ANALYSIS_KEY="analysis/"
AWS_S3_RECORDINGS_KEY="recordings/"
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Shared bearer secret for internal Lambda callbacks. Configure the same value
# as backend_webhook_api_key in lambda/terraform/terraform.tfvars.
BACKEND_WEBHOOK_API_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Generate with: openssl rand -hex 32
ROOM_CODE_PEPPER_HEX=

# Fixed delay before relaying room events to other members (0s disables).
# Example: ROOM_FAKE_SERVER_DELAY=250ms
ROOM_FAKE_SERVER_DELAY=0s
